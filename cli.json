[
  {
    "id": "claude-code",
    "name": "Claude Code",
    "package": "@anthropic-ai/claude-code",
    "env": {
      "minimal": [
        {
          "key": "ANTHROPIC_BASE_URL",
          "description": "Anthropic-compatible API base URL"
        },
        {
          "key": "ANTHROPIC_API_KEY",
          "description": "Access Key"
        }
      ],
      "extended": [
        {
          "key": "ANTHROPIC_MODEL",
          "description": "Default model",
          "default": "auto"
        }
      ]
    }
  },
  {
    "id": "openai-compatible",
    "name": "OpenAI Compatible CLI",
    "package": "openai-compatible",
    "env": {
      "minimal": [
        {
          "key": "OPENAI_BASE_URL",
          "description": "OpenAI-compatible API base URL"
        },
        {
          "key": "OPENAI_API_KEY",
          "description": "Access Key"
        }
      ],
      "extended": [
        {
          "key": "OPENAI_MODEL",
          "description": "Default model",
          "default": "auto"
        }
      ]
    }
  },
  {
    "id": "cline-roo",
    "name": "Cline / Roo Code",
    "package": "custom-openai-provider",
    "env": {
      "minimal": [
        {
          "key": "OPENAI_BASE_URL",
          "description": "Provider base URL"
        },
        {
          "key": "OPENAI_API_KEY",
          "description": "Access Key"
        }
      ],
      "extended": [
        {
          "key": "PROVIDER",
          "description": "Provider protocol",
          "default": "openai"
        },
        {
          "key": "MODEL",
          "description": "Default model",
          "default": "auto"
        }
      ]
    }
  }
]
