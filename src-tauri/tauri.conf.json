{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wuAPI",
  "version": "0.6.9",
  "identifier": "com.wuapi.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wuAPI",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
